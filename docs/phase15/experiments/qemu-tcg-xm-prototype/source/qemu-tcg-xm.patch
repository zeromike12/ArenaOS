+/*
+ * TCG records SSE arithmetic exceptions in softfloat state. Convert the flags
+ * raised by each instruction into the architectural unmasked #XM/#UD fault.
+ * The destination snapshot lets SIMD instructions roll back all lanes before
+ * the synchronous fault is delivered.
+ */
+static inline int sse_begin_instruction(CPUX86State *env)
+{
+    int old_flags = get_float_exception_flags(&env->sse_status);
+    set_float_exception_flags(0, &env->sse_status);
+    return old_flags;
+}
+
+static void sse_finish_instruction(CPUX86State *env, int old_flags,
+                                   ZMMReg *dst, ZMMReg old_dst,
+                                   uintptr_t retaddr)
+{
+    int new_flags = get_float_exception_flags(&env->sse_status);
+    uint32_t status =
+        ((new_flags & float_flag_invalid) ? FPUS_IE : 0) |
+        ((new_flags & float_flag_input_denormal_used) ? FPUS_DE : 0) |
+        ((new_flags & float_flag_divbyzero) ? FPUS_ZE : 0) |
+        ((new_flags & float_flag_overflow) ? FPUS_OE : 0) |
+        ((new_flags & float_flag_underflow) ? FPUS_UE : 0) |
+        ((new_flags & float_flag_inexact) ? FPUS_PE : 0) |
+        ((new_flags & float_flag_output_denormal_flushed) ? FPUS_UE | FPUS_PE : 0);
+    uint32_t unmasked = status & ~((env->mxcsr >> 7) & 0x3f);
+
+    set_float_exception_flags(old_flags | new_flags, &env->sse_status);
+    if (unmasked) {
+        *dst = old_dst;
+        update_mxcsr_from_sse_status(env);
+        if (!(env->cr[4] & CR4_OSXMMEXCPT_MASK)) {
+            raise_exception_ra(env, EXCP06_ILLOP, retaddr);
+        }
+        raise_exception_ra(env, EXCP19_XM, retaddr);
+    }
+}
