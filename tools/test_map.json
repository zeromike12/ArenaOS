{
  "schema": 1,
  "comment": "Affected-test selection for tools/arena_test.py. Rules are tried in order; the first matching glob classifies a path. Registry-declared per-entry paths, changed-suite-reverse-imports, and the always-on quick set are added on top. A path matching NOTHING triggers the conservative full registered fallback in the runner. Every guest boot replays all in-guest milestones, so generic boot health is always covered by the quick smoke boot; these rules select the suites that assert the changed component. When in doubt, widen a rule rather than narrow it.",
  "groups": { "always": ["quick"] },
  "rules": [
    { "glob": "docs/*", "select_groups": [], "reason": "documentation only; quick set still runs, no guest evidence is claimed" },
    { "glob": "*.md", "select_groups": [], "reason": "documentation only" },
    { "glob": "releases/*", "select_groups": [], "reason": "release artifacts/notes are not built into the image; package gates run in qualify mode" },

    { "glob": "kernel/*", "select_groups": ["registered"], "reason": "kernel changes can affect every guest boot" },
    { "glob": "*/Cargo.toml", "select_groups": ["registered"], "reason": "dependency/feature changes are treated as global" },
    { "glob": "*/Cargo.lock", "select_groups": ["registered"], "reason": "dependency changes are treated as global" },
    { "glob": "*/.cargo/*", "select_groups": ["registered"], "reason": "cargo target configuration is global to its workspace builds" },
    { "glob": "vendor/*", "select_groups": ["registered"], "reason": "vendored dependencies feed signed-package crypto paths" },

    { "glob": "tools/build.sh", "select_groups": ["registered"], "reason": "the canonical build defines every test image" },
    { "glob": "tools/build_phase14_pie.sh", "select_groups": ["registered"], "reason": "protected Phase 14 fixture path" },
    { "glob": "tools/build_phase14_bundle.py", "select_groups": ["registered"], "reason": "protected Phase 14 bundle path" },
    { "glob": "tools/mtest.py", "select_groups": ["registered"], "select": ["infra-selftest"], "reason": "shared guest harness for almost every suite" },
    { "glob": "tools/arena_env.py", "select_groups": ["registered"], "reason": "backend/firmware/fixture resolution for every boot" },
    { "glob": "tools/espimg.py", "select_groups": ["registered"], "reason": "ESP imaging feeds every boot" },
    { "glob": "tools/audit_kernel_isa.py", "select_groups": ["registered"], "reason": "kernel ISA audit runs in every build" },
    { "glob": "tools/afs1.py", "select_groups": ["registered"], "reason": "AFS1 layout oracle formats the scratch disk of every boot" },
    { "glob": "tools/qmp.py", "select_prefixes": ["m6-", "m9-", "m10-", "m11-", "phase13-"], "reason": "QMP typing/screenshot channel" },
    { "glob": "tools/vcon.py", "select_prefixes": ["m6-"], "reason": "virtio-console actor" },
    { "glob": "tools/tcp_fixture.py", "select_prefixes": ["m7"], "select": ["host-tcp-parser", "host-net-api"], "reason": "host TCP peer" },
    { "glob": "tools/udp_dns_fixture.py", "select_prefixes": ["m7", "m9-"], "select": ["host-dns-parser"], "reason": "host DNS peer" },
    { "glob": "tools/afs2.py", "select_prefixes": ["m11-"], "select": ["host-afs2"], "reason": "AFS2 host oracle" },
    { "glob": "tools/phase85-elf-probe*/*", "select_prefixes": ["m85-", "m10-"], "reason": "guest probe fixtures used by install/upgrade suites" },
    { "glob": "tools/run_tests.sh", "select_groups": ["registered"], "reason": "the reference registry itself changed; parity must be re-established" },
    { "glob": "tools/arena_test.py", "select": ["infra-selftest"], "reason": "test runner only" },
    { "glob": "tools/build_cache.py", "select": ["infra-selftest"], "reason": "build cache only" },
    { "glob": "tools/gen_test_registry.py", "select": ["infra-selftest"], "reason": "registry generator only" },
    { "glob": "tools/test_registry.json", "select": ["infra-selftest"], "reason": "registry data only" },
    { "glob": "tools/test_map.json", "select": ["infra-selftest"], "reason": "affected mapping only" },
    { "glob": "tools/test_arena_test_infra.py", "select": ["infra-selftest"], "reason": "infra self-test only" },
    { "glob": "tools/backend_controls.py", "select": ["infra-selftest", "backend-xm-controls"], "reason": "backend suitability gate" },
    { "glob": "tools/fresh_archive_verify.py", "select": ["infra-selftest", "fresh-archive-phase16"], "reason": "package verification flow" },
    { "glob": "tools/*", "select_groups": ["registered"], "reason": "other shared harness/tooling; conservative" },

    { "glob": "userspace/abi.rs", "select_groups": ["registered", "phase16"], "reason": "the syscall ABI is global" },
    { "glob": "userspace/arena-lib/*", "select_groups": ["registered"], "reason": "linked by guests across milestones" },
    { "glob": "userspace/arena-platform/*", "select": ["host-phase12"], "select_prefixes": ["m12-", "phase13-", "phase14-"], "select_groups": ["phase16"], "reason": "startup record validation" },
    { "glob": "userspace/arena-runtime/*", "select": ["host-phase12"], "select_prefixes": ["m12-", "phase13-"], "select_groups": ["phase16"], "reason": "native runtime incl. ASTR streams" },
    { "glob": "userspace/arena-process/*", "select_groups": ["registered"], "reason": "linked by the Phase 14 fixture and runtime paths" },
    { "glob": "userspace/arena-startup-abi/*", "select_groups": ["registered"], "reason": "startup ABI is shared" },
    { "glob": "userspace/payload/*", "select_prefixes": ["m4"], "reason": "embedded ring-3 payload" },
    { "glob": "userspace/shell/*", "select_groups": ["registered-guests"], "reason": "the shell ends every boot (shutdown path)" },
    { "glob": "userspace/storaged/*", "select_prefixes": ["m5", "m81-", "m82-", "m84-", "m85-"], "reason": "block service under every filesystem path" },
    { "glob": "userspace/fsd/*", "select_prefixes": ["m5", "m81-", "m82-", "m84-", "m85-"], "reason": "AFS1 service" },
    { "glob": "userspace/filesd/*", "select_prefixes": ["m11-", "phase13-"], "reason": "AFS2 file service" },
    { "glob": "userspace/afs2/*", "select": ["host-afs2"], "select_prefixes": ["m11-", "phase13-"], "reason": "AFS2 engine" },
    { "glob": "userspace/netd/*", "select_prefixes": ["m6", "m7"], "reason": "link driver" },
    { "glob": "userspace/netstackd/*", "select": ["host-dns-parser", "host-tcp-parser", "host-net-api"], "select_prefixes": ["m7", "m83-"], "reason": "protocol stack" },
    { "glob": "userspace/rngd/*", "select_prefixes": ["m6", "phase14-"], "reason": "entropy service" },
    { "glob": "userspace/inputd/*", "select_prefixes": ["m6", "m9-", "m10-"], "reason": "keyboard path" },
    { "glob": "userspace/consoled/*", "select_prefixes": ["m6"], "reason": "console channel" },
    { "glob": "userspace/faultd/*", "select_prefixes": ["m6", "m8-", "m83-"], "reason": "fault-injection pair" },
    { "glob": "userspace/timertest/*", "select_prefixes": ["m7"], "reason": "timer facility proof" },
    { "glob": "userspace/servicemgr/*", "select": ["host-servicemgr-manifest", "host-phase13"], "select_prefixes": ["m8", "phase13-"], "reason": "service manager: lifecycle, packaged/permissiond supervision" },
    { "glob": "userspace/configd/*", "select": ["host-config-record"], "select_prefixes": ["m81-"], "reason": "config service" },
    { "glob": "userspace/config.rs", "select": ["host-config-record"], "select_prefixes": ["m81-"], "reason": "config codec" },
    { "glob": "userspace/permissiond/*", "select": ["host-permission-record"], "select_prefixes": ["m82-"], "reason": "permission broker" },
    { "glob": "userspace/permission.rs", "select": ["host-permission-record"], "select_prefixes": ["m82-"], "reason": "permission codec" },
    { "glob": "userspace/packaged/*", "select_prefixes": ["m84-", "m85-", "m10-", "m12-", "phase13-", "phase14-"], "reason": "package receiver" },
    { "glob": "userspace/displayd/*", "select_prefixes": ["m9-", "m10-", "m11-"], "reason": "display service" },
    { "glob": "userspace/gpu2d/*", "select_prefixes": ["m9-"], "reason": "GPU 2D path" },
    { "glob": "userspace/compositord/*", "select_prefixes": ["m9-"], "reason": "compositor" },
    { "glob": "userspace/desktop/*", "select": ["host-phase13"], "select_prefixes": ["m10-", "m11-", "m12-", "phase13-", "phase14-"], "select_groups": ["phase16"], "reason": "desktop/session, window and stream grant paths" },
    { "glob": "userspace/gfxkit/*", "select_prefixes": ["m9-", "m10-"], "reason": "graphics toolkit" },
    { "glob": "userspace/ui/*", "select_prefixes": ["m10-", "m11-"], "reason": "UI components" },
    { "glob": "userspace/phase13-app/*", "select_prefixes": ["phase13-"], "reason": "installed-app fixture" },
    { "glob": "userspace/phase13-headless/*", "select_prefixes": ["phase13-"], "reason": "installed-app fixture" },
    { "glob": "userspace/phase14-pie/*", "select_prefixes": ["phase14-", "m12-"], "reason": "protected PIE fixture crate" },
    { "glob": "userspace/phase15-fpu/*", "select_prefixes": ["m15"], "select": ["strict-m15-final"], "reason": "ring-3 FP/SIMD fixtures" },
    { "glob": "userspace/depcheck/*", "select_prefixes": ["m8-"], "reason": "dependency probe image" },
    { "glob": "phase9-work/*", "select_prefixes": ["m9-"], "reason": "original compositor + two window clients" },

    { "glob": "experiments/c-runtime/*", "select_groups": ["phase16"], "select": ["host-phase12"], "reason": "canonical C runtime + targeted guest suites" },
    { "glob": "experiments/*", "select_groups": [], "reason": "experiments are outside the shipped image" },
    { "glob": "audit/*", "select_prefixes": ["m84-"], "reason": "crypto audit crate feeding packaged verification" }
  ]
}
